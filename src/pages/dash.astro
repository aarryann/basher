---
import BaseLayout from "../layouts/BaseLayout.astro"

---
<BaseLayout>
  <style slot="head">
    button {
      -webkit-touch-callout: none;
      /* iOS Safari */
      -webkit-user-select: none;
      /* Safari */
      -khtml-user-select: none;
      /* Konqueror HTML */
      -moz-user-select: none;
      /* Firefox */
      -ms-user-select: none;
      /* Internet Explorer/Edge */
      user-select: none;
      /* Non-prefixed version, currently supported by Chrome and Opera */
    }

    button,
    [role="button"],
    .interactive {
      touch-action: none;
    }

    @keyframes fade {
      0% {
        opacity: 1;
      }

      100% {
        opacity: 0;
      }
    }

    .fade-out {
      animation: fade 0.8s linear forwards;
    }
  </style>


<body class="bg-black text-cyan-400" x-data="dashboard">
  <div class="flex items-center justify-between w-full">
    <div x-show="displayMessage" x-transition:enter="transition transform ease-out duration-500"
      x-transition:enter-start="-translate-x-full opacity-0" x-transition:enter-end="translate-x-0 opacity-100"
      x-transition:leave="transition transform ease-in duration-500"
      x-transition:leave-start="translate-x-0 opacity-100" x-transition:leave-end="-translate-x-full opacity-0"
      class="w-full p-4 bg-gray-900 h-16"> <span x-text="displayMessage" class="text-sm text-white"></span>
    </div>
    <div class="w-full p-4 bg-gray-900 flex h-16 grow-0 justify-center">
      <input id="search" x-show="isMessageDisplayHidden" x-transition:enter="transition transform ease-out duration-500"
        x-transition:enter-start="translate-x-full opacity-0" x-transition:enter-end="translate-x-0 opacity-100"
        x-transition:leave="transition transform ease-in duration-500"
        x-transition:leave-start="translate-x-0 opacity-100" x-transition:leave-end="translate-x-full opacity-0"
        type="text" placeholder="Search widgets..."
        class="w-full max-w-2xl p-2 rounded-lg bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
        x-model="searchQuery" />
      <button x-show="displayMessage" @click="hideMessage" class="ml-auto">
        <i class="fas fa-search"></i>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-3 sm:grid-cols-12 md:grid-cols-18 lg:grid-cols-24 xl:grid-cols-30 gap-4 p-5 auto-rows-min">
    <template x-for="(widget, index) in filteredWidgets" :key="index">
      <button :class="widgetClass" :data-index="index" x-data="card"
        class="bg-gray-800 rounded-lg p-2 hover:bg-gray-600 transition relative text-left" @mousedown="startHold"
        @touchstart="startHold" @mouseup="endHold" @touchend="endHold" @mouseleave="cancelHold" @touchmove="cancelHold">
        <div class="flex items-center justify-between h-full">
          <div class="flex items-center justify-end w-6">
          </div>
          <div class="flex flex-col items-center text-sm grow">
            <i :class="iconClass"></i>
            <span class="whitespace-nowrap" x-text="title"></span>
          </div>
          <div class="flex items-center h-full w-6">
            <span x-show="downCount" x-text="downCount" :class="getCountdownClass"
              class="text-2xl font-bold text-white"></span>
          </div>
        </div>
      </button>
    </template>
  </div>

  <div class="grid grid-cols-2 gap-4 p-5 auto-rows-min">
    <!-- First Row: Back Button (left-aligned) and Run Button (right-aligned) -->
    <button class="bg-gray-800 rounded-lg p-2 hover:bg-gray-600 transition justify-self-start">Back Button</button>
    <button class="bg-gray-800 rounded-lg p-2 hover:bg-gray-600 transition justify-self-start">Run Button</button>

    <!-- Second Row: Empty space (to align Alternate Run Button) and Alternate Run Button (right-aligned) -->
    <div></div>
    <button class="bg-gray-800 rounded-lg p-2 hover:bg-gray-600 transition justify-self-start">Alternate Run
      Button</button>

    <!-- Third Row: Settings Button (left-aligned) and Show Logs Button (right-aligned) -->
    <button class="bg-gray-800 rounded-lg p-2 hover:bg-gray-600 transition justify-self-start">Settings Button</button>
    <button class="bg-gray-800 rounded-lg p-2 hover:bg-gray-600 transition justify-self-start">Show Logs</button>
  </div>


  <!-- Full-Screen Modal for Mobile -->
  <div id="modal" class="overlay" x-show="modalVisible" x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-300" x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0" x-cloak>
    <div class="bg-gray-800 rounded-lg p-5 text-white max-w-sm w-full">
      <button @click="closeModal" class="absolute top-2 right-2 text-2xl">&times;</button>
      <div id="modalContent" class="content max-h-96 overflow-y-auto" x-html="modalContent">
        <!-- Logs or feedback will be displayed here -->
      </div>
    </div>
  </div>

  <!-- Theme Toggle -->
  <div class="fixed bottom-5 left-5">
    <button @click="toggleLock" class="bg-gray-800 text-white p-3 rounded-full">
      <i :class="lockClass"></i>
    </button>
  </div>
  <div class="fixed bottom-5 right-5">
    <button @click="toggleTheme" class="bg-gray-800 text-white p-3 rounded-full">
      <i class="fas fa-adjust"></i>
    </button>
  </div>

</body>

</html>