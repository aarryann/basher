---
import BaseLayout from "../layouts/BaseLayout.astro";
import RunForm from "../components/Dash/RunForm.astro";
import Card from "../components/Dash/Card.astro";
---

<BaseLayout>
  <Fragment slot="head">
    <title>Homation Dashboard</title>
    <script type="module" src="/scripts/main.js"></script>
  </Fragment>
  <style>
    button {
      -webkit-touch-callout: none;
      /* iOS Safari */
      -webkit-user-select: none;
      /* Safari */
      -khtml-user-select: none;
      /* Konqueror HTML */
      -moz-user-select: none;
      /* Firefox */
      -ms-user-select: none;
      /* Internet Explorer/Edge */
      user-select: none;
      /* Non-prefixed version, currently supported by Chrome and Opera */
    }

    button,
    [role="button"],
    .interactive {
      touch-action: none;
    }

    @keyframes fade {
      0% {
        opacity: 1;
      }

      100% {
        opacity: 0;
      }
    }

    .fade-out {
      animation: fade 0.8s linear forwards;
    }
  </style>

  <div class="m-0 p-0" x-data="dashboard">
    <div class="flex items-center justify-between w-full">
      <div
        x-show="displayMessage"
        x-transition:enter="transition transform ease-out duration-500"
        x-transition:enter-start="-translate-x-full opacity-0"
        x-transition:enter-end="translate-x-0 opacity-100"
        x-transition:leave="transition transform ease-in duration-500"
        x-transition:leave-start="translate-x-0 opacity-100"
        x-transition:leave-end="-translate-x-full opacity-0"
        class="w-full p-4 bg-gray-900 h-16"
      >
        <span x-text="displayMessage" class="text-sm text-white"></span>
      </div>
      <div class="w-full p-4 bg-gray-900 flex h-16 grow-0 justify-center">
        <input
          id="search"
          x-show="isMessageDisplayHidden"
          x-transition:enter="transition transform ease-out duration-500"
          x-transition:enter-start="translate-x-full opacity-0"
          x-transition:enter-end="translate-x-0 opacity-100"
          x-transition:leave="transition transform ease-in duration-500"
          x-transition:leave-start="translate-x-0 opacity-100"
          x-transition:leave-end="translate-x-full opacity-0"
          type="text"
          placeholder="Search widgets..."
          class="w-full max-w-2xl p-2 rounded-lg bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
          x-model="searchQuery"
        />
        <button x-show="displayMessage" @click="hideMessage" class="ml-auto">
          <i class="fas fa-search"></i>
        </button>
      </div>
    </div>

    <div class="grid grid-cols-3 sm:grid-cols-12 md:grid-cols-18 lg:grid-cols-24 xl:grid-cols-30 gap-4 p-5 auto-rows-min">
      <template x-for="(widget, index) in filteredWidgets" :key="index">
        <Card />
      </template>
    </div>

    <RunForm />

    <!-- Theme Toggle -->
    <div class="fixed bottom-5 left-5" slot="footer-action">
      <button @click="toggleLock" class="bg-gray-800 text-white p-3 rounded-full">
        <i :class="lockClass"></i>
      </button>
    </div>
  </div>
</BaseLayout>
