---

<!-- Full-Screen Modal for Mobile -->
<div
  id="modal"
  class="overlay"
  x-show="modalVisible"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-300"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  x-cloak
>
  <div class="bg-gray-800 rounded-lg p-5 text-white max-w-sm w-full">
    <button @click="closeModal" class="absolute top-2 right-2 text-2xl">&times;</button>
    <div id="modalContent" class="content max-h-96 overflow-y-auto" x-html="modalContent">
      <!-- Logs or feedback will be displayed here -->
    </div>
  </div>
</div>
