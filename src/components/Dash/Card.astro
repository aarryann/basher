---

---

<!-- Receives this.$data.widget -->
<button :class="widgetClass" x-data="card" class="bg-gray-800 rounded-lg p-2 hover:bg-gray-600 transition relative text-left" @mousedown="startHold" @touchstart="startHold" @mouseup="endHold" @touchend="endHold" @mouseleave="cancelHold" @touchmove="cancelHold">
  <div class="flex items-center justify-between h-full">
    <div class="flex items-center justify-end w-6"></div>
    <div class="flex flex-col items-center text-sm grow">
      <i :class="iconClass"></i>
      <span class="whitespace-nowrap" x-text="title"></span>
    </div>
    <div class="flex items-center h-full w-6">
      <span x-show="downCount" x-text="downCount" :class="getCountdownClass" class="text-2xl font-bold text-white"></span>
    </div>
  </div>
</button>
