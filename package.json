{
  "name": "basher",
  "version": "1.0.0",
  "description": "A web dashboard for running and displaying the output of bash commands",
  "main": "index.js",
  "scripts": {
    "start": "run-p start:src start:pkg start:srv",
    "start:1": "node server.js",
    "start:src": "nodemon --config nodemon.src.json --exec 'astro build'",
    "start:pkg": "sleep 2 && npx tailwindcss -i main.css -o public/styles/tailwind.min.css -m --watch",
    "start:srv": "sleep 2 && nodemon --config nodemon.srv.json server.js",
    "dev": "nodemon server.js",
    "wsdev": "nodemon wsserver.js",
    "docker:build": "docker compose up -d",
    "docker:run": "docker run --rm -d -p 3111:3111 --restart unless-stopped homation:latest ",
    "docker:clean": "docker compose stop homation && docker compose rm homation",
    "docker:tag": "docker tag homation:latest aarryann/homation:latest",
    "docker:push": "docker push aarryann/homation:latest",
    "build": "astro build"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.14.1",
    "astro": "^4.15.6",
    "axios": "^1.7.7",
    "child_process": "^1.0.2",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "http": "0.0.1-security",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.10"
  },
  "keywords": [
    "dashboard",
    "bash",
    "express",
    "axios",
    "alpinejs",
    "tailwindcss"
  ],
  "author": "Your Name",
  "license": "MIT"
}